# Copy this file to .env before running. Do not commit real secrets.
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-before-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Almaty
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200,http://127.0.0.1:5173
POSTGRES_DB=university_service_request
POSTGRES_USER=university_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
